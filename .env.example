# UPI Offline Mesh - Docker Environment Configuration
# Copy this file to .env to customize settings

# Port exposed on the host for the Frontend web app (Nginx)
FRONTEND_PORT=80

# Secondary port mapping matching the Vite dev port for backward compatibility
FRONTEND_DEV_PORT=5173

# Port exposed on the host for direct Spring Boot backend API access & H2 console
BACKEND_PORT=8080

# Spring active profile
SPRING_PROFILES_ACTIVE=docker

# JVM memory and optimization flags
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
